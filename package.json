{
  "name": "ui-jev",
  "version": "0.1.0",
  "private": true,
  "description": "AI-generated UI: Jev plans, json-render renders. Landing page in the style of json-render.dev.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "node server/plan.js",
    "dev:all": "node server/plan.js & vite",
    "test": "node scripts/test-policy.js",
    "smoke": "esbuild scripts/smoke.tsx --bundle --platform=node --format=esm --outfile=/tmp/ui-jev-smoke.mjs --log-level=error && node /tmp/ui-jev-smoke.mjs"
  },
  "dependencies": {
    "@json-render/core": "^0.20.0",
    "@json-render/react": "^0.20.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.8"
  }
}
